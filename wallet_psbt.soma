(** Bounded, pure Bitcoin transaction / PSBT v0 (BIP 174) framing and the
    native P2WPKH SIGHASH_ALL digest (BIP 143). Bytes are lists of
    primitive ints below 256, as Soma.Crypto's SHA-256 takes them.
    Every reader consumes its input list or a small fuel, so malicious
    lengths cannot cause unbounded recursion; every length is checked
    against a finite limit before bytes are taken. No IO, keys or signing. *)

Require Import Crypto.
From Corelib Require Import PrimInt63.
Local Open Scope uint63_scope.

bytes : Type := list int.

(** ** Limits (development policy) *)
max_psbt_bytes : int := 100000.
max_key_bytes : int := 128.
max_value_bytes : int := 100000.
max_script_bytes : int := 10000.
max_tx_inputs : int := 64.
max_tx_outputs : int := 64.
max_money : int := 2100000000000000.
(** fuel: one more than the largest number of entries a map may hold *)
map_fuel : nat := 65%nat.
count_fuel : nat := 65%nat.

Inductive parse_error :=
| Truncated
| NoncanonicalCompactSize
| LengthTooLarge
| InputTooLarge
| BadMagic
| TooManyEntries
| DuplicateKey
| InvalidKeyLength
| MissingUnsignedTx
| UnsupportedPsbtVersion
| UnsupportedTxVersion
| WitnessSerializedUnsignedTx
| NoInputs
| NoOutputs
| TooManyInputs
| TooManyOutputs
| NonEmptyScriptSig
| ScriptTooLarge
| AmountOutOfRange
| TrailingBytes
| InputIndexOutOfRange
| MissingWitnessUtxo
| MalformedWitnessUtxo
| UnsupportedScript
| UnsupportedSighash
| ByteOutOfRange
| TotalAmountOutOfRange
| UnsupportedNonWitnessUtxo
| UnsupportedRedeemScript
| UnsupportedWitnessScript
| InvalidBase64Char
| InvalidBase64Padding.

Inductive outcome (A : Type) := Done (value : A) | Fail (error : parse_error).
Arguments Done {A} value.
Arguments Fail {A} error.

bind {A B : Type} (r : outcome A) (f : A -> outcome B) : outcome B :=
  match r with Done a => f a | Fail e => Fail e end.

(** ** Bytes *)
len {A : Type} (b : list A) : int := fold_left (fun n _ => add n 1) b 0.

Fixpoint bytes_eqb (a b : bytes) : bool :=
  match a, b with
  | [], [] => true
  | x :: a', y :: b' => if eqb x y then bytes_eqb a' b' else false
  | _, _ => false
  end.

(** Public entry points reject any integer outside the byte range 0..255;
    the alias [list int] alone does not enforce it. *)
Fixpoint bytes_in_range (b : bytes) : bool :=
  match b with
  | [] => true
  | x :: r => andb (andb (negb (ltb x 0)) (negb (ltb 255 x))) (bytes_in_range r)
  end.

(** at most [budget] elements, found by walking no further than that *)
Fixpoint list_within {A : Type} (l : list A) (budget : int) : bool :=
  match l with
  | [] => true
  | _ :: rest => if eqb budget 0 then false else list_within rest (sub budget 1)
  end.

(** little-endian value of at most 7 bytes (fits in 63 bits) *)
le_value (b : bytes) : int := fold_right (fun x acc => lor x (lsl acc 8)) 0 b.

Fixpoint le_bytes (n : nat) (v : int) : bytes :=
  match n with O => [] | S k => land v 255 :: le_bytes k (lsr v 8) end.

Fixpoint take_acc (n : int) (b : bytes) (acc : bytes) : outcome (bytes * bytes) :=
  if eqb n 0 then Done (rev acc, b) else
  match b with
  | [] => Fail Truncated
  | x :: r => take_acc (sub n 1) r (x :: acc)
  end.

(** exactly [n] bytes, or [Truncated] *)
take (n : int) (b : bytes) : outcome (bytes * bytes) := take_acc n b [].

(** BIP 174/Bitcoin CompactSize; only the shortest encoding is accepted,
    and the 9-byte form always exceeds every limit here. *)
read_compact (b : bytes) : outcome (int * bytes) :=
  match b with
  | [] => Fail Truncated
  | x :: r =>
      if ltb x 253 then Done (x, r)
      else if eqb x 253 then
        bind (take 2 r) (fun p => let (h, t) := p in
          let v := le_value h in
          if ltb v 253 then Fail NoncanonicalCompactSize else Done (v, t))
      else if eqb x 254 then
        bind (take 4 r) (fun p => let (h, t) := p in
          let v := le_value h in
          if ltb v 65536 then Fail NoncanonicalCompactSize else Done (v, t))
      else
        bind (take 8 r) (fun p => let (h, _) := p in
          if bytes_eqb (skipn 4 h) [0, 0, 0, 0] then Fail NoncanonicalCompactSize
          else Fail LengthTooLarge)
  end.

encode_compact (n : int) : bytes :=
  if ltb n 253 then [n]
  else if ltb n 65536 then 253 :: le_bytes 2 n
  else 254 :: le_bytes 4 n.

(** a CompactSize length, then that many bytes, at most [limit] *)
read_var (limit : int) (too_large : parse_error) (b : bytes) : outcome (bytes * bytes) :=
  bind (read_compact b) (fun p => let (n, r) := p in
    if ltb limit n then Fail too_large else take n r).

encode_var (b : bytes) : bytes := encode_compact (len b) ++ b.

(** ** Transactions (legacy serialization only: an unsigned PSBT tx) *)
Inductive tx_input := TxIn (prevout : bytes) (sequence : bytes).
Inductive tx_output := TxOut (amount : int) (script : bytes).
Inductive tx := Tx (version : int) (inputs : list tx_input) (outputs : list tx_output) (locktime : int).

read_amount (b : bytes) : outcome (int * bytes) :=
  bind (take 8 b) (fun p => let (h, t) := p in
    if negb (eqb (nth 7 h 0) 0) then Fail AmountOutOfRange else
    let v := le_value (firstn 7 h) in
    if ltb max_money v then Fail AmountOutOfRange else Done (v, t)).

(** BIP 174: an unsigned transaction's scriptSigs are empty *)
read_input (b : bytes) : outcome (tx_input * bytes) :=
  bind (take 36 b) (fun p => let (prevout, r) := p in
    bind (read_compact r) (fun p => let (slen, r2) := p in
      if negb (eqb slen 0) then Fail NonEmptyScriptSig else
      bind (take 4 r2) (fun p => let (sequence, r3) := p in
        Done (TxIn prevout sequence, r3)))).

read_output (b : bytes) : outcome (tx_output * bytes) :=
  bind (read_amount b) (fun p => let (amount, r) := p in
    bind (read_var max_script_bytes ScriptTooLarge r) (fun p => let (script, r2) := p in
      Done (TxOut amount script, r2))).

(** Total output value must not exceed MAX_MONEY. Each amount is already at
    most MAX_MONEY and there are at most 64 outputs, so the running sum stays
    far below the 63-bit wrap point and this comparison cannot overflow. *)
Fixpoint check_total (outs : list tx_output) (acc : int) : outcome unit :=
  match outs with
  | [] => Done tt
  | TxOut a _ :: rest =>
      if ltb max_money (add acc a) then Fail TotalAmountOutOfRange
      else check_total rest (add acc a)
  end.

Fixpoint read_many {A : Type} (fuel : nat) (item : bytes -> outcome (A * bytes))
    (n : int) (b : bytes) (acc : list A) : outcome (list A * bytes) :=
  if eqb n 0 then Done (rev acc, b) else
  match fuel with
  | O => Fail TooManyEntries
  | S f => bind (item b) (fun p => let (x, r) := p in read_many f item (sub n 1) r (x :: acc))
  end.

read_tx (b : bytes) : outcome (tx * bytes) :=
  bind (take 4 b) (fun p => let (vb, r) := p in
    let version := le_value vb in
    if negb (orb (eqb version 1) (eqb version 2)) then Fail UnsupportedTxVersion else
    bind (read_compact r) (fun p => let (nin, r2) := p in
      if eqb nin 0 then
        (if eqb (nth 0 r2 0) 1 then Fail WitnessSerializedUnsignedTx else Fail NoInputs)
      else if ltb max_tx_inputs nin then Fail TooManyInputs else
      bind (read_many count_fuel read_input nin r2 []) (fun p => let (ins, r3) := p in
        bind (read_compact r3) (fun p => let (nout, r4) := p in
          if eqb nout 0 then Fail NoOutputs
          else if ltb max_tx_outputs nout then Fail TooManyOutputs else
          bind (read_many count_fuel read_output nout r4 []) (fun p => let (outs, r5) := p in
            bind (check_total outs 0) (fun _ =>
            bind (take 4 r5) (fun p => let (lb, r6) := p in
              Done (Tx version ins outs (le_value lb), r6)))))))).

(** the whole of [b] is one unsigned transaction *)
parse_tx (b : bytes) : outcome tx :=
  if negb (list_within b max_psbt_bytes) then Fail InputTooLarge else
  if negb (bytes_in_range b) then Fail ByteOutOfRange else
  bind (read_tx b) (fun p => let (t, r) := p in
    match r with [] => Done t | _ => Fail TrailingBytes end).

serialize_input (i : tx_input) : bytes :=
  match i with TxIn prevout sequence => prevout ++ [0] ++ sequence end.
serialize_output (o : tx_output) : bytes :=
  match o with TxOut amount script => le_bytes 8 amount ++ encode_var script end.
serialize_outputs (outs : list tx_output) : bytes := flat_map serialize_output outs.

serialize_tx (t : tx) : bytes :=
  match t with
  | Tx version ins outs locktime =>
      le_bytes 4 version ++ encode_compact (len ins) ++ flat_map serialize_input ins
      ++ encode_compact (len outs) ++ serialize_outputs outs ++ le_bytes 4 locktime
  end.

(** ** PSBT v0 maps *)
Inductive entry := Entry (key : bytes) (value : bytes).
psbt_map : Type := list entry.

key_of (e : entry) : bytes := match e with Entry k _ => k end.

lookup (k : bytes) (m : psbt_map) : option bytes :=
  match find (fun e => bytes_eqb (key_of e) k) m with
  | Some (Entry _ v) => Some v
  | None => None
  end.

(** Allowed key-data lengths (the key after its type byte) of the key
    types BIP 174 and BIP 371 fix, per map; other types are kept as they are. *)
key_rules : Type := list (int * list int).
pubkey_lengths : list int := [33, 65].
global_key_rules : key_rules := [(0, [0]), (1, [78]), (251, [0])].
input_key_rules : key_rules := [(0, [0]), (1, [0]), (2, pubkey_lengths), (3, [0]), (4, [0]),
  (5, [0]), (6, pubkey_lengths), (7, [0]), (8, [0]), (10, [20]), (11, [32]), (12, [20]),
  (13, [32]), (19, [0]), (20, [64]), (22, [32]), (23, [0]), (24, [0])].
output_key_rules : key_rules := [(0, [0]), (1, [0]), (2, pubkey_lengths), (5, [0]), (6, [0]),
  (7, [32])].

key_ok (rules : key_rules) (k : bytes) : bool :=
  match k with
  | [] => false
  | t :: rest =>
      match find (fun r => eqb (fst r) t) rules with
      | Some (_, lengths) => existsb (eqb (len rest)) lengths
      | None => true
      end
  end.

(** one map: entries until the 0x00 separator; duplicate keys rejected *)
Fixpoint read_map_acc (fuel : nat) (single : key_rules) (b : bytes) (acc : psbt_map)
    : outcome (psbt_map * bytes) :=
  match fuel with
  | O => Fail TooManyEntries
  | S f =>
      bind (read_compact b) (fun p => let (klen, r) := p in
        if eqb klen 0 then Done (rev acc, r)
        else if ltb max_key_bytes klen then Fail LengthTooLarge else
        bind (take klen r) (fun p => let (k, r2) := p in
          if negb (key_ok single k) then Fail InvalidKeyLength else
          bind (read_var max_value_bytes LengthTooLarge r2) (fun p => let (v, r3) := p in
            match lookup k acc with
            | Some _ => Fail DuplicateKey
            | None => read_map_acc f single r3 (Entry k v :: acc)
            end)))
  end.

read_map (single : key_rules) (b : bytes) : outcome (psbt_map * bytes) :=
  read_map_acc map_fuel single b [].

serialize_map (m : psbt_map) : bytes :=
  flat_map (fun e => match e with Entry k v => encode_var k ++ encode_var v end) m ++ [0].

Inductive psbt := Psbt (global : psbt_map) (unsigned : tx)
  (input_maps : list psbt_map) (output_maps : list psbt_map).

magic : bytes := [112, 115, 98, 116, 255].

parse_psbt (b : bytes) : outcome psbt :=
  if negb (list_within b max_psbt_bytes) then Fail InputTooLarge else
  if negb (bytes_in_range b) then Fail ByteOutOfRange else
  if negb (bytes_eqb (firstn 5 b) magic) then Fail BadMagic else
  bind (read_map global_key_rules (skipn 5 b)) (fun p => let (g, r) := p in
    bind (match lookup [251] g with
          | Some v => if bytes_eqb v [0, 0, 0, 0] then Done tt else Fail UnsupportedPsbtVersion
          | None => Done tt
          end) (fun _ =>
    match lookup [0] g with
    | None => Fail MissingUnsignedTx
    | Some raw =>
        bind (parse_tx raw) (fun t =>
          match t with
          | Tx _ ins outs _ =>
              bind (read_many count_fuel (read_map input_key_rules) (len ins) r [])
                (fun p => let (im, r2) := p in
              bind (read_many count_fuel (read_map output_key_rules) (len outs) r2 [])
                (fun p => let (om, r3) := p in
              match r3 with
              | [] => Done (Psbt g t im om)
              | _ => Fail TrailingBytes
              end))
          end)
    end)).

(** Every entry is kept in order with canonical lengths, so a parsed PSBT
    serializes back to its exact bytes. *)
serialize_psbt (p : psbt) : bytes :=
  match p with
  | Psbt g _ im om => magic ++ serialize_map g ++ flat_map serialize_map im ++ flat_map serialize_map om
  end.

(** ** BIP 143 native P2WPKH, SIGHASH_ALL *)
dsha256 (b : bytes) : bytes := sha256_of_bytes (sha256_of_bytes b).

(** a witness UTXO value: 8-byte amount and a scriptPubKey, nothing else *)
parse_witness_utxo (v : bytes) : outcome (bytes * bytes) :=
  bind (take 8 v) (fun p => let (amount, r) := p in
    bind (read_amount amount) (fun _ =>
      bind (read_var max_script_bytes ScriptTooLarge r) (fun p => let (script, r2) := p in
        match r2 with [] => Done (amount, script) | _ => Fail MalformedWitnessUtxo end))).

(** OP_0 PUSH20 <20-byte key hash> *)
p2wpkh_hash (script : bytes) : outcome bytes :=
  if andb (bytes_eqb (firstn 2 script) [0, 20]) (eqb (len script) 22)
  then Done (skipn 2 script) else Fail UnsupportedScript.

(** Native P2WPKH policy: a digest is never produced from conflicting or
    unsupported UTXO/script metadata for the selected input. Such entries are
    still preserved by the parser for round trips; only the digest rejects. *)
metadata_ok (m : psbt_map) : outcome unit :=
  match lookup [0] m with
  | Some _ => Fail UnsupportedNonWitnessUtxo
  | None =>
      match lookup [4] m with
      | Some _ => Fail UnsupportedRedeemScript
      | None =>
          match lookup [5] m with
          | Some _ => Fail UnsupportedWitnessScript
          | None => Done tt
          end
      end
  end.

sighash_all_ok (m : psbt_map) : outcome unit :=
  match lookup [3] m with
  | None => Done tt
  | Some v => if bytes_eqb v [1, 0, 0, 0] then Done tt else Fail UnsupportedSighash
  end.

input_prevout (i : tx_input) : bytes := match i with TxIn p _ => p end.
input_sequence (i : tx_input) : bytes := match i with TxIn _ s => s end.

(** the 32-byte digest a signature of input [index] commits to *)
p2wpkh_sighash_all (p : psbt) (index : nat) : outcome bytes :=
  match p with
  | Psbt _ (Tx version ins outs locktime) im _ =>
      match nth_error ins index, nth_error im index with
      | Some i, Some m =>
          bind (metadata_ok m) (fun _ =>
          bind (sighash_all_ok m) (fun _ =>
          match lookup [1] m with
          | None => Fail MissingWitnessUtxo
          | Some wu =>
              bind (parse_witness_utxo wu) (fun q => let (amount, script) := q in
              bind (p2wpkh_hash script) (fun h =>
                Done (dsha256 (le_bytes 4 version
                  ++ dsha256 (flat_map input_prevout ins)
                  ++ dsha256 (flat_map input_sequence ins)
                  ++ input_prevout i
                  ++ [25, 118, 169, 20] ++ h ++ [136, 172]
                  ++ amount
                  ++ input_sequence i
                  ++ dsha256 (serialize_outputs outs)
                  ++ le_bytes 4 locktime
                  ++ [1, 0, 0, 0]))))
          end))
      | _, _ => Fail InputIndexOutOfRange
      end
  end.

(** ** Strict Base64 text form (BIP 174), bounded and canonical

    Decoding consumes four characters at a time and fails with
    [InputTooLarge] as soon as the decoded length would exceed
    [max_psbt_bytes], so an over-long input is rejected after a bounded
    prefix rather than after a whole-input allocation or scan in this
    module. Only canonical padded Base64 is accepted: in a one-byte
    group the unused low four bits of the second value must be zero,
    and in a two-byte group the unused low two bits of the third value
    must be zero, so distinct encodings cannot alias the same bytes. *)
b64_value (c : int) : int :=
  if andb (negb (ltb c 65)) (negb (ltb 90 c)) then sub c 65
  else if andb (negb (ltb c 97)) (negb (ltb 122 c)) then add (sub c 97) 26
  else if andb (negb (ltb c 48)) (negb (ltb 57 c)) then add (sub c 48) 52
  else if eqb c 43 then 62
  else if eqb c 47 then 63
  else if eqb c 61 then 64
  else 999.

Fixpoint b64_groups (chars : bytes) (acc : bytes) (count : int) : outcome bytes :=
  match chars with
  | [] => Done (rev acc)
  | a :: b :: c :: d :: rest =>
      let va := b64_value a in
      let vb := b64_value b in
      let vc := b64_value c in
      let vd := b64_value d in
      if orb (orb (eqb va 999) (eqb vb 999)) (orb (eqb vc 999) (eqb vd 999))
      then Fail InvalidBase64Char
      else if orb (eqb va 64) (eqb vb 64) then Fail InvalidBase64Padding
      else if eqb vc 64 then
        if negb (eqb vd 64) then Fail InvalidBase64Padding
        else if negb (eqb (land vb 15) 0) then Fail InvalidBase64Padding
        else match rest with
             | [] => if ltb max_psbt_bytes (add count 1) then Fail InputTooLarge
                     else Done (rev (lor (lsl va 2) (lsr vb 4) :: acc))
             | _ => Fail InvalidBase64Padding
             end
      else if eqb vd 64 then
        if negb (eqb (land vc 3) 0) then Fail InvalidBase64Padding
        else match rest with
             | [] => if ltb max_psbt_bytes (add count 2) then Fail InputTooLarge
                     else Done (rev (lor (lsl (land vb 15) 4) (lsr vc 2)
                                     :: lor (lsl va 2) (lsr vb 4) :: acc))
             | _ => Fail InvalidBase64Padding
             end
      else if ltb max_psbt_bytes (add count 3) then Fail InputTooLarge
      else b64_groups rest
             (lor (lsl (land vc 3) 6) vd
              :: lor (lsl (land vb 15) 4) (lsr vc 2)
              :: lor (lsl va 2) (lsr vb 4) :: acc)
             (add count 3)
  | _ => Fail InvalidBase64Padding
  end.

base64_decode (chars : bytes) : outcome bytes := b64_groups chars [] 0.

(** Parse a PSBT in its strict Base64 text form (ASCII bytes). *)
parse_psbt_base64 (chars : bytes) : outcome psbt :=
  bind (base64_decode chars) (fun raw => parse_psbt raw).
