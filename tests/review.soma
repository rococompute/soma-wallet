Import wallet_psbt.
Import wallet_review.
Require Import Crypto.
From Corelib Require Import PrimInt63.
Local Open Scope uint63_scope.

hex (s : string) : bytes := match bytes_of_hex s with Some l => l | None => [] end.
kv (k v : bytes) : bytes := encode_var k ++ encode_var v.
contains (needle : string) (hay : string) : bool :=
  let n := bytes_of_string needle in
  (fix go (h : bytes) : bool := match h with [] => false | _ :: rest => if starts_with n h then true else go rest end)
    (bytes_of_string hay).

(** BIP 143's native P2WPKH example as a PSBT (tests/psbt.soma): input 1
    carries a witness UTXO, input 0 does not *)
unsigned : bytes := hex "".
gen_script : bytes := hex "0014751e76e8199196d454941c45d1b3a323f1433bd6".
bip143 : bytes := magic ++ kv [0] unsigned ++ [0] ++ [0] ++ kv [1] (hex "0046c323000000001600141d0f172a0ecb48aee1be1f2687d2963ae33f71a1") ++ [0, 0, 0].
both_amounts : bytes := magic ++ kv [0] unsigned ++ [0] ++ kv [1] (le_bytes 8 625000000 ++ encode_var gen_script) ++ [0]
  ++ kv [1] (hex "0046c323000000001600141d0f172a0ecb48aee1be1f2687d2963ae33f71a1") ++ [0, 0, 0].
negative : bytes := magic ++ kv [0] unsigned ++ [0] ++ kv [1] (le_bytes 8 1 ++ encode_var gen_script) ++ [0]
  ++ kv [1] (le_bytes 8 2 ++ encode_var gen_script) ++ [0, 0, 0].
(** one input paying the public scalar-one key's P2WPKH, 10000 sat fee *)
spend : bytes := [2, 0, 0, 0, 1] ++ repeat 17 32%nat ++ [0, 0, 0, 0, 0, 255, 255, 255, 255, 1]
  ++ le_bytes 8 599990000 ++ encode_var gen_script ++ [0, 0, 0, 0].
to_self : bytes := magic ++ kv [0] spend ++ [0] ++ kv [1] (le_bytes 8 600000000 ++ encode_var gen_script) ++ [0] ++ [0].

review_bytes (b : bytes) : option review := match parse_psbt b with Done p => Some (review_of p) | Fail _ => None end.
output_summary (r : option review) : list (int * string * list string) :=
  match r with Some (Review _ _ _ outs _ _) => map (fun o => match o with OutputView a k _ ad => (a, k, ad) end) outs | None => [] end.
input_summary (r : option review) : list (string * int * option int) :=
  match r with Some (Review _ _ ins _ _ _) => map (fun i => match i with InputView t v a => (t, v, a) end) ins | None => [] end.
totals (r : option review) : option (int * fee_view) :=
  match r with Some (Review _ _ _ _ t f) => Some (t, f) | None => None end.

(** the served page for raw HTTP requests *)
response_head (r : string) : bool :=
  starts_with (bytes_of_string (Stdlib.Strings.String.concat "" ["HTTP/1.1 200 OK", crlf, "Content-Type: text/html; charset=utf-8", crlf, "X-Content-Type-Options: nosniff", crlf])) (bytes_of_string (serve_response r)).
