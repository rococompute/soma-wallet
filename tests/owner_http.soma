Import wallet_psbt wallet_review wallet_owner_http.
Require Import Crypto.
From Corelib Require Import PrimInt63.
Local Open Scope uint63_scope.
line (s : string) : string := String.append s crlf.
post (path body : string) (extra : string) : string := txt [
  line (txt ["POST ",path," HTTP/1.1"]), line "Host: wallet",
  line "Content-Type: application/x-www-form-urlencoded",
  line (txt ["Content-Length: ", decimal (count (bytes_of_string body))]),
  extra, crlf, body].
get : string := txt [line "GET / HTTP/1.1", line "Host: wallet", crlf].
error_of (r : owner_http_result) : option owner_http_error :=
  match r with HttpRejected e => Some e | HttpCommand _ => None end.

(** Existing public synthetic regtest PSBT, form-encoded independently by Python. *)
