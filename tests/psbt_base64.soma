Import wallet_psbt.
Require Import Crypto.
From Corelib Require Import PrimInt63.
Local Open Scope uint63_scope.

hex (s : string) : bytes := match bytes_of_hex s with Some l => l | None => [] end.

(** The BIP 143 native-P2WPKH PSBT fixture (see tests/psbt.soma) in its
    strict Base64 text form per BIP 174, plus RFC 4648 examples. *)
fixture : bytes := hex ("70736274ff0100a0" ++ "" ++ "000001011f0046c323000000001600141d0f172a0ecb48aee1be1f2687d2963ae33f71a1000000").
fixture_b64 : bytes := [99, 72, 78, 105, 100, 80, 56, 66, 65, 75, 65, 66, 65, 65, 65, 65, 65, 118, 47, 51, 57, 52, 103, 97, 103, 74, 109, 118, 112, 112, 81, 78, 81, 116, 72, 110, 57, 106, 89, 114, 55, 68, 103, 88, 72, 113, 80, 116, 57, 68, 78, 85, 72, 98, 84, 107, 114, 90, 97, 102, 65, 65, 65, 65, 65, 65, 68, 117, 47, 47, 47, 47, 55, 49, 72, 104, 117, 65, 84, 77, 105, 100, 71, 67, 48, 110, 108, 108, 88, 68, 113, 111, 110, 111, 70, 98, 71, 122, 67, 102, 52, 111, 102, 90, 115, 114, 86, 100, 86, 55, 107, 79, 120, 111, 111, 66, 65, 65, 65, 65, 65, 80, 47, 47, 47, 47, 56, 67, 73, 67, 121, 121, 66, 103, 65, 65, 65, 65, 65, 90, 100, 113, 107, 85, 103, 111, 67, 122, 102, 102, 78, 52, 50, 53, 110, 50, 98, 52, 88, 74, 87, 110, 103, 54, 100, 113, 120, 54, 98, 86, 109, 73, 114, 74, 67, 84, 85, 81, 48, 65, 65, 65, 65, 65, 71, 88, 97, 112, 70, 68, 118, 101, 81, 116, 118, 117, 102, 107, 50, 43, 97, 105, 71, 121, 49, 81, 122, 105, 56, 66, 90, 47, 113, 111, 70, 90, 105, 75, 119, 82, 65, 65, 65, 65, 65, 65, 65, 66, 65, 82, 56, 65, 82, 115, 77, 106, 65, 65, 65, 65, 65, 66, 89, 65, 70, 66, 48, 80, 70, 121, 111, 79, 121, 48, 105, 117, 52, 98, 52, 102, 74, 111, 102, 83, 108, 106, 114, 106, 80, 51, 71, 104, 65, 65, 65, 65].
error_of {A : Type} (r : outcome A) : option parse_error := match r with Done _ => None | Fail e => Some e end.
round_trip_b64 : outcome bytes := bind (parse_psbt_base64 fixture_b64) (fun q => Done (serialize_psbt q)).
