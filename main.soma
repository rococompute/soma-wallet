Require Import Sandbox JSX.
Import wallet_review.

(** The offline wallet page. GET shows the locked wallet and the PSBT import
    form; POST /review shows the parsed transaction or its typed rejection
    (wallet_review). The served session is always Locked in this build, so
    key import, approval, signing and export are shown unavailable. *)
main : io unit := serve 8080 (fun request => ret (serve_response request)).
