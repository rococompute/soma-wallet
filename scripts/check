#!/usr/bin/env python3
"""Serialized host checks; paths are relative to this exact bid checkout."""
import fcntl, os, pathlib, subprocess, sys
root=pathlib.Path(__file__).resolve().parents[1]
env=os.environ.copy();env['SOMA_MIRAGE_SWITCH']='hvf'
with open('/private/tmp/soma-wallet-build.lock','a') as lock:
    fcntl.flock(lock,fcntl.LOCK_EX)
    subprocess.run(['./scripts/build-crypto'],cwd=root,env=env,check=True)
    for file in ['main.soma','crypto/smoke.soma']+[str(p.relative_to(root)) for p in sorted((root/'tests').glob('*.soma'))]:
        subprocess.run(['opam','exec','--switch=hvf','--','soma','build',file],cwd=root,env=env,check=True)
    result=subprocess.run(['timeout','90','opam','exec','--switch=hvf','--','solo5-hvt','--mem=256','--',str(root/'crypto/smoke.hvt')],cwd=root,env=env,capture_output=True,text=True)
    if result.returncode or 'flags = 31' not in result.stdout or 'private key is rejected = 0' not in result.stdout:
        print(result.stdout);print(result.stderr,file=sys.stderr);sys.exit(1)
    for test in sorted((root/'tests').glob('*.mjs')):
        subprocess.run(['node',str(test)],cwd=root,env=env,check=True)
    for test in sorted((root/'tests').glob('test_*.py')):
        subprocess.run([sys.executable,str(test)],cwd=root,env=env,check=True)
print('PASS: JSX UI image builds; real signing image boots; app-local WASM validation succeeds.')
