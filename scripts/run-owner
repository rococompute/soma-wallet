#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
case "${1-}" in
  '') selected_arg='' ;;
  --public-fixture) selected_arg='--arg=public-fixture' ;;
  *) echo 'usage: scripts/run-owner [--public-fixture]' >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then echo 'usage: scripts/run-owner [--public-fixture]' >&2; exit 2; fi
./scripts/check
if [ -n "$selected_arg" ]; then
  exec opam exec --switch=hvf -- solo5-vmnet --mode=host --isolate -- solo5-hvt --mem=256 -- "$PWD/tests/owner_app_build.hvt" "$selected_arg"
else
  exec opam exec --switch=hvf -- solo5-vmnet --mode=host --isolate -- solo5-hvt --mem=256 -- "$PWD/tests/owner_app_build.hvt"
fi
